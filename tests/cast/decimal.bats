load ../psql_tests.bash



@test "fn: sparql.cast_as_decimal_from_boolean('f'::bool)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_decimal_from_boolean('t'::bool)" {
  expect_output '1'
}

@test "fn: sparql.cast_as_decimal_from_byte('-128'::int2)" {
  expect_output '-128'
}

@test "fn: sparql.cast_as_decimal_from_byte('127'::int2)" {
  expect_output '127'
}

@test "fn: sparql.cast_as_decimal_from_unsignedbyte('0'::int2)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_decimal_from_unsignedbyte('255'::int2)" {
  expect_output '255'
}

@test "fn: sparql.cast_as_decimal_from_short('-32768'::int2)" {
  expect_output '-32768'
}

@test "fn: sparql.cast_as_decimal_from_short('32767'::int2)" {
  expect_output '32767'
}

@test "fn: sparql.cast_as_decimal_from_unsignedshort('0'::int4)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_decimal_from_unsignedshort('65535'::int4)" {
  expect_output '65535'
}

@test "fn: sparql.cast_as_decimal_from_int('-2147483648'::int4)" {
  expect_output '-2147483648'
}

@test "fn: sparql.cast_as_decimal_from_int('2147483647'::int4)" {
  expect_output '2147483647'
}

@test "fn: sparql.cast_as_decimal_from_unsignedint('0'::int8)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_decimal_from_unsignedint('4294967295'::int8)" {
  expect_output '4294967295'
}

@test "fn: sparql.cast_as_decimal_from_long('-9223372036854775808'::int8)" {
  expect_output '-9223372036854775808'
}

@test "fn: sparql.cast_as_decimal_from_long('9223372036854775807'::int8)" {
  expect_output '9223372036854775807'
}

@test "fn: sparql.cast_as_decimal_from_unsignedlong('0'::decimal)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_decimal_from_unsignedlong('18446744073709551615'::decimal)" {
  expect_output '18446744073709551615'
}

@test "fn: sparql.cast_as_decimal_from_integer('-'::decimal)" {
  expect_output '-'
}

@test "fn: sparql.cast_as_decimal_from_integer('-'::decimal)" {
  expect_output '-'
}

@test "fn: sparql.cast_as_decimal_from_integer(''::decimal)" {
  expect_output ''
}

@test "fn: sparql.cast_as_decimal_from_integer(''::decimal)" {
  expect_output ''
}

@test "fn: sparql.cast_as_decimal_from_nonpositiveinteger('-18446744073709551616'::decimal)" {
  expect_output '-18446744073709551616'
}

@test "fn: sparql.cast_as_decimal_from_nonpositiveinteger('0'::decimal)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_decimal_from_negativeinteger('-18446744073709551616'::decimal)" {
  expect_output '-18446744073709551616'
}

