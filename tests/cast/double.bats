  expect_output '1.1754943508222875e-38'
}

@test "fn: sparql.cast_as_double_from_float('3.402823466e38'::float4)" {
  expect_output '3.4028234663852886e+38'
}

@test "fn: sparql.cast_as_double_from_float('inf'::float4)" {
  expect_output 'Infinity'
}

