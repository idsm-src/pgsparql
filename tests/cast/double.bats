load ../psql_tests.bash



@test "fn: sparql.cast_as_double_from_boolean('f'::bool)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_double_from_boolean('t'::bool)" {
  expect_output '1'
}

@test "fn: sparql.cast_as_double_from_byte('-128'::int2)" {
  expect_output '-128'
}

@test "fn: sparql.cast_as_double_from_byte('127'::int2)" {
  expect_output '127'
}

@test "fn: sparql.cast_as_double_from_unsignedbyte('0'::int2)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_double_from_unsignedbyte('255'::int2)" {
  expect_output '255'
}

@test "fn: sparql.cast_as_double_from_short('-32768'::int2)" {
  expect_output '-32768'
}

@test "fn: sparql.cast_as_double_from_short('32767'::int2)" {
  expect_output '32767'
}

@test "fn: sparql.cast_as_double_from_unsignedshort('0'::int4)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_double_from_unsignedshort('65535'::int4)" {
  expect_output '65535'
}

@test "fn: sparql.cast_as_double_from_int('-2147483648'::int4)" {
  expect_output '-2147483648'
}

@test "fn: sparql.cast_as_double_from_int('2147483647'::int4)" {
  expect_output '2147483647'
}

@test "fn: sparql.cast_as_double_from_unsignedint('0'::int8)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_double_from_unsignedint('4294967295'::int8)" {
  expect_output '4294967295'
}

@test "fn: sparql.cast_as_double_from_long('-9223372036854775808'::int8)" {
  expect_output '-9.223372036854776e+18'
}

@test "fn: sparql.cast_as_double_from_long('9223372036854775807'::int8)" {
  expect_output '9.223372036854776e+18'
}

@test "fn: sparql.cast_as_double_from_unsignedlong('0'::decimal)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_double_from_unsignedlong('18446744073709551615'::decimal)" {
  expect_output '1.8446744073709552e+19'
}

@test "fn: sparql.cast_as_double_from_integer('-'::decimal)" {
  expect_output '-Infinity'
}

@test "fn: sparql.cast_as_double_from_integer('-'::decimal)" {
  expect_output '-1.7976931348623157e+308'
}

@test "fn: sparql.cast_as_double_from_integer(''::decimal)" {
  expect_output '1.7976931348623157e+308'
}

@test "fn: sparql.cast_as_double_from_integer(''::decimal)" {
  expect_output 'Infinity'
}

@test "fn: sparql.cast_as_double_from_nonpositiveinteger('-18446744073709551616'::decimal)" {
  expect_output '-1.8446744073709552e+19'
}

@test "fn: sparql.cast_as_double_from_nonpositiveinteger('0'::decimal)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_double_from_negativeinteger('-18446744073709551616'::decimal)" {
  expect_output '-1.8446744073709552e+19'
}

@test "fn: sparql.cast_as_double_from_negativeinteger('-1'::decimal)" {
  expect_output '-1'
}

@test "fn: sparql.cast_as_double_from_nonnegativeinteger('0'::decimal)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_double_from_nonnegativeinteger('18446744073709551616'::decimal)" {
  expect_output '1.8446744073709552e+19'
}

@test "fn: sparql.cast_as_double_from_positiveinteger('1'::decimal)" {
  expect_output '1'
}

@test "fn: sparql.cast_as_double_from_positiveinteger('18446744073709551616'::decimal)" {
  expect_output '1.8446744073709552e+19'
}

@test "fn: sparql.cast_as_double_from_decimal('-'::decimal)" {
  expect_output '-Infinity'
}

@test "fn: sparql.cast_as_double_from_decimal('-'::decimal)" {
  expect_output '-1.7976931348623157e+308'
}

@test "fn: sparql.cast_as_double_from_decimal('-0.'::decimal)" {
  expect_output '-2.2250738585072014e-308'
}

@test "fn: sparql.cast_as_double_from_decimal('-0.'::decimal)" {
  expect_output '-0'
}

@test "fn: sparql.cast_as_double_from_decimal('0.'::decimal)" {
  expect_output '0'
}

@test "fn: sparql.cast_as_double_from_decimal('0.'::decimal)" {
  expect_output '2.2250738585072014e-308'
}

@test "fn: sparql.cast_as_double_from_decimal(''::decimal)" {
  expect_output '1.7976931348623157e+308'
}

@test "fn: sparql.cast_as_double_from_decimal(''::decimal)" {
  expect_output 'Infinity'
}

@test "fn: sparql.cast_as_double_from_float('-inf'::float4)" {
  expect_output '-Infinity'
}

@test "fn: sparql.cast_as_double_from_float('-3.402823466e38'::float4)" {
  expect_output '-3.4028234663852886e+38'
}

@test "fn: sparql.cast_as_double_from_float('-1.175494351e-38'::float4)" {
  expect_output '-1.1754943508222875e-38'
}

